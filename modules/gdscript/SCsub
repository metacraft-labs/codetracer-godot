#!/usr/bin/env python
from misc.utility.scons_hints import *

import os

Import("env")
Import("env_modules")

env_gdscript = env_modules.Clone()

# --- GDH-M5 falsifier arms ---------------------------------------------
# `CT_GDH5_FALSIFY` names a mutation to compile into the recorder's reload
# path, and it is applied to THIS MODULE'S environment only.
#
# It is scoped here rather than added to the global CCFLAGS for a measured
# reason: a change to the engine-wide CCFLAGS invalidates every object in the
# tree, so the first version of the GDH-M5 arm runner triggered a FULL rebuild
# (thirdparty/embree and all) per arm — four of them, about an hour. Scoped to
# `env_gdscript`, an armed build is one translation unit plus a relink, ~20 s.
#
# It is empty in every ordinary build. `scripts/record-and-verify-gdh5.sh` is
# its only user, and it prints the value so an armed binary cannot be mistaken
# for a plain one.
_ct_gdh5_falsify = os.environ.get("CT_GDH5_FALSIFY", "")
if _ct_gdh5_falsify:
    print("CodeTracer GDH-M5 FALSIFIER ARM: -D%s (this is NOT a plain build)" % _ct_gdh5_falsify)
    env_gdscript.Append(CPPDEFINES=[_ct_gdh5_falsify])

# --- GDH-M6 falsifier arms ---------------------------------------------
# Same mechanism, same scope, same reason. `CT_GDH6_FALSIFY` may name MORE
# than one mutation, comma-separated, because two of GDH-M6's gates are
# graded against the same recording and an arm aimed at one of them has to
# be shown not to have reddened the other by accident.
_ct_gdh6_falsify = os.environ.get("CT_GDH6_FALSIFY", "")
if _ct_gdh6_falsify:
    for _arm in [a.strip() for a in _ct_gdh6_falsify.split(",") if a.strip()]:
        print("CodeTracer GDH-M6 FALSIFIER ARM: -D%s (this is NOT a plain build)" % _arm)
        env_gdscript.Append(CPPDEFINES=[_arm])

# --- GDH-M8 falsifier arms, and the injection-hook OPT-OUT ---------------
# Same mechanism and same scope. Two kinds of define arrive through it and the
# difference is worth stating, because one of them is not a falsifier:
#
#   CT_GDH8_FALSIFY_*         a mutation, exactly like the GDH-M5/M6 arms.
#   CT_GDH8_NO_INJECTION_HOOK compiles the fault-injection hook OUT.
#
# The second exists because `gdh8_a_failure_after_registration_closes_the_
# trace_rather_than_continuing` injects its failure through a hook in SHIPPED
# code, and the milestone accepts that only if the hook's inertness is
# MEASURED. The measurement is "an unarmed build with the hook produces a
# container byte-identical to a build without it", and the second build is what
# this define produces. A comment asserting the hook is off would not be a
# measurement.
_ct_gdh8_falsify = os.environ.get("CT_GDH8_FALSIFY", "")
if _ct_gdh8_falsify:
    for _arm in [a.strip() for a in _ct_gdh8_falsify.split(",") if a.strip()]:
        print("CodeTracer GDH-M8 FALSIFIER ARM: -D%s (this is NOT a plain build)" % _arm)
        env_gdscript.Append(CPPDEFINES=[_arm])

# --- GDH-M6 AddressSanitizer, scoped to this module ---------------------
# `gdh6_a_timed_out_deferral_does_not_outlive_its_request` is killed by the
# SANITIZER'S REPORT, never by a crash: the defect it guards is a
# use-after-free with a 30-second fuse, and a fuse that long usually does not
# blow on demand. So the recorder's translation unit is built with
# `-fsanitize=address` and the engine is linked against the runtime.
#
# Scoped to `env_gdscript` for the compile and to `env` for the link, exactly
# as the writer's static library is: an engine-wide `-fsanitize=address`
# invalidates every object in the tree and costs a full rebuild (measured at
# 813 s while bringing GDH-M5's arms up), whereas this is one translation unit
# plus a relink.
#
# `detect_leaks=0` is NOT set here. The gate sets ASAN_OPTIONS itself, so the
# choice is visible in the harness rather than baked into the binary.
#
# `ASAN_ENABLED` IS REQUIRED FROM GODOT 4.7 ONWARDS, and it is not optional
# bookkeeping. 4.7 added a guard to `core/typedefs.h` (:65-67):
#
#     #if (GD_HAS_FEATURE(address_sanitizer) || defined(__SANITIZE_ADDRESS__)) \
#             && !defined(ASAN_ENABLED)
#     #error Address sanitizer was enabled without defining `ASAN_ENABLED`
#
# so at 4.6.2 this block worked with the flag alone and at 4.7.2 it stops the
# build dead — every `modules/gdscript` translation unit fails at the `#error`.
# Upstream pairs the two itself wherever it turns the sanitizer on (see
# `platform/linuxbsd/detect.py`'s `use_asan` branch, which does
# `CPPDEFINES=["ASAN_ENABLED"]` immediately before the `-fsanitize=address`
# CCFLAGS), and this mirrors that pairing at the scope we use. It is defined on
# `env_gdscript` only, matching where the flag is applied: the rest of the tree
# is not sanitized and must not claim to be, since `ASAN_ENABLED` also gates
# real behavior in the engine (allocator hooks, poisoning helpers).
if os.environ.get("CT_GDH6_ASAN", "") not in ("", "0"):
    print("CodeTracer GDH-M6: -fsanitize=address on modules/gdscript (this is NOT a plain build)")
    env_gdscript.Append(CPPDEFINES=["ASAN_ENABLED"])
    env_gdscript.Append(CCFLAGS=["-fsanitize=address", "-fno-omit-frame-pointer"])
    env.Append(LINKFLAGS=["-fsanitize=address"])

# --- CodeTracer G2: link the CTFS writer static lib ---------------------
# The recorder links codetracer-trace-format-nim's C-ABI trace writer: a header
# (compile time) and a static archive (link time). The glue TU
# gdscript_ct_trace.cpp is picked up by the "*.cpp" glob below.
#
# ONE REVISION, AND A STALE WRITER FAILS THE BUILD. The writer revision is
# declared once, by the `codetracer-trace-format-nim` input in the repository's
# flake.lock. A writer built from any other revision writes containers the
# current readers may refuse, or decode differently, so it is never linked:
#
#   1. Inside `nix develop`, the dev shell exports CT_TRACE_WRITER_DIR: the
#      archive and header the flake builds FROM THE PINNED SOURCE (package
#      `ct-trace-writer`). That is what gets linked. Its recorded revision must
#      equal the lock's; a shell entered before the lock moved is refused.
#   2. Without it (plain scons, e.g. CI), the VENDORED copy under
#      ct_writer/<platform>-<arch>/ is used, and only if its PROVENANCE.json
#      names the locked revision and the sha256 of both the archive and
#      ct_writer/include/codetracer_trace_writer.h match. Re-vendor with
#      scripts/vendor-trace-writer.sh after moving the lock.
#
# The archive is the writer's `buildStaticLib` command plus `-d:useMalloc`
# (see `ct-trace-writer` in flake.nix): the engine calls the writer from its
# own worker threads, and with Nim's per-thread heaps the main thread's close
# freed memory owned by a worker that had already exited (a SIGSEGV at exit
# on every gf_threads.gd run).
import hashlib
import json


def _ct_sha256(path):
    with open(path, "rb") as f:
        return hashlib.sha256(f.read()).hexdigest()


def _ct_writer_locked_rev():
    lock_path = os.path.join(Dir("#").abspath, "flake.lock")
    try:
        with open(lock_path) as f:
            return json.load(f)["nodes"]["codetracer-trace-format-nim"]["locked"]["rev"]
    except (OSError, KeyError, ValueError) as e:
        raise RuntimeError(
            "cannot read the pinned trace writer revision from %s (%s); the "
            "`codetracer-trace-format-nim` input is the only declaration of it" % (lock_path, e)
        )


_ct_writer_rev = _ct_writer_locked_rev()
_ct_writer_archive = "codetracer_trace_writer.lib" if env["platform"] == "windows" else "libcodetracer_trace_writer.a"
_ct_writer_env_dir = os.environ.get("CT_TRACE_WRITER_DIR", "")
if _ct_writer_env_dir:
    with open(os.path.join(_ct_writer_env_dir, "rev")) as f:
        _built_rev = f.read().strip()
    if _built_rev != _ct_writer_rev:
        raise RuntimeError(
            "CT_TRACE_WRITER_DIR holds a trace writer built from %s, but flake.lock pins %s. "
            "The dev shell predates the lock: leave it and run `nix develop` again." % (_built_rev, _ct_writer_rev)
        )
    _ct_writer_include = os.path.join(_ct_writer_env_dir, "include")
    _ct_writer_archive_path = os.path.join(_ct_writer_env_dir, "lib", _ct_writer_archive)
    print("CodeTracer trace writer: %s, built from the pinned source (%s)" % (_ct_writer_rev[:12], _ct_writer_env_dir))
else:
    _ct_writer_include = Dir("ct_writer/include").srcnode().abspath
    _ct_vendor_dir = Dir("ct_writer/%s-%s" % (env["platform"], env["arch"])).srcnode().abspath
    _ct_writer_archive_path = os.path.join(_ct_vendor_dir, _ct_writer_archive)
    _ct_provenance_path = os.path.join(_ct_vendor_dir, "PROVENANCE.json")
    _ct_revendor = (
        "Build inside `nix develop` (which builds the writer from the pinned source), "
        "or re-vendor with scripts/vendor-trace-writer.sh."
    )
    if not os.path.exists(_ct_writer_archive_path):
        raise RuntimeError(
            "no vendored CodeTracer trace writer for %s-%s under %s. %s"
            % (env["platform"], env["arch"], _ct_vendor_dir, _ct_revendor)
        )
    if not os.path.exists(_ct_provenance_path):
        raise RuntimeError(
            "the vendored CodeTracer trace writer for %s-%s has no PROVENANCE.json, so the revision it "
            "was built from is unknown and it cannot be checked against flake.lock (%s). %s"
            % (env["platform"], env["arch"], _ct_writer_rev, _ct_revendor)
        )
    with open(_ct_provenance_path) as f:
        _ct_provenance = json.load(f)
    _ct_header_path = os.path.join(_ct_writer_include, "codetracer_trace_writer.h")
    _ct_stale = []
    if _ct_provenance.get("rev") != _ct_writer_rev:
        _ct_stale.append("it was built from %s, and flake.lock pins %s" % (_ct_provenance.get("rev"), _ct_writer_rev))
    if _ct_provenance.get("archive_sha256") != _ct_sha256(_ct_writer_archive_path):
        _ct_stale.append("the archive is not the one PROVENANCE.json records")
    if _ct_provenance.get("header_sha256") != _ct_sha256(_ct_header_path):
        _ct_stale.append("the header is not the one PROVENANCE.json records")
    if _ct_stale:
        raise RuntimeError(
            "the vendored CodeTracer trace writer for %s-%s is stale: %s. %s"
            % (env["platform"], env["arch"], "; ".join(_ct_stale), _ct_revendor)
        )
    print("CodeTracer trace writer: %s, vendored (%s)" % (_ct_writer_rev[:12], _ct_vendor_dir))
env_gdscript.Prepend(CPPPATH=[_ct_writer_include])
# Pass an exact file node. A bare library name inherits Godot's extra suffix
# and would incorrectly rename this prebuilt dependency in custom variants.
env.Append(LIBS=[File(_ct_writer_archive_path)])
# Runtime deps the Nim/arc static lib pulls in:
if env["platform"] in ["linuxbsd", "android"]:
    env.Append(LIBS=["zstd", "m", "pthread"])
elif env["platform"] == "macos":
    env.Append(LIBS=["zstd"])
    env.Append(LINKFLAGS=["-framework", "Security", "-framework", "CoreFoundation"])
elif env["platform"] == "windows":
    # The vendored writer is compiled with Nim's MSVC backend. Its zstd
    # bindings use this matching MSVC archive rather than the incompatible
    # MinGW archive used by GCC-hosted Windows builds.
    env.Append(LIBS=[File("C:/zstd/lib/zstd.lib")])
    env.Append(LINKFLAGS=["bcrypt.lib"])

env_gdscript.add_source_files(env.modules_sources, "*.cpp")

if env.editor_build:
    env_gdscript.add_source_files(env.modules_sources, "./editor/*.cpp")

    SConscript("editor/script_templates/SCsub")

    # Those two modules are required for the language server protocol
    if env["module_jsonrpc_enabled"] and env["module_websocket_enabled"]:
        env_gdscript.add_source_files(env.modules_sources, "./language_server/*.cpp")
    else:
        # Using a define in the disabled case, to avoid having an extra define
        # in regular builds where all modules are enabled.
        env_gdscript.Append(CPPDEFINES=["GDSCRIPT_NO_LSP"])
        # Also needed in main env to unexpose --lsp-port option.
        env.Append(CPPDEFINES=["GDSCRIPT_NO_LSP"])


if env["tests"]:
    # TODO: Handle test creation magic without needing to pass macro.
    env_gdscript.Append(CPPDEFINES=["TESTS_ENABLED"])
    env_gdscript.add_source_files(env.modules_sources, "./tests/*.cpp")
