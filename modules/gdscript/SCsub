#!/usr/bin/env python
from misc.utility.scons_hints import *

import os

Import("env")
Import("env_modules")

env_gdscript = env_modules.Clone()

# --- CodeTracer G2: link the CTFS writer static lib ---------------------
# The C-ABI header (compile-time) and libcodetracer_trace_writer.a
# (link-time) come from codetracer-trace-format-nim, vendored under
# modules/gdscript/ct_writer/ (header in ct_writer/include/). The glue TU
# gdscript_ct_trace.cpp is picked up by the "*.cpp" glob below.
# The static lib is a *native* object archive, so it is vendored per host
# platform+arch: `ct_writer/` holds the macOS arm64 build (the platform the
# recorder was first brought up on) and `ct_writer/<platform>-<arch>/` (scons'
# own platform/arch spelling, e.g. `linuxbsd-x86_64`) holds any other build.
# Note the two archives are not interchangeable in a subtler way than being
# different ISAs: the macOS one carries a `__.SYMDEF` index, which GNU ld
# rejects outright ("archive has no index"), so a Linux link that silently
# picked it up fails at the very last step of a full engine build.
# The Linux x86_64 archive was produced from
# codetracer-trace-format-nim with the repo's own `buildStaticLib` command
# (`nim c --app:staticlib --mm:arc --noMain -d:release
#  --nimMainPrefix:codetracerTraceWriter --passC:-fPIC -p:src`), run inside
# that repo's `nix develop` shell so libzstd's headers resolve.
env_gdscript.Prepend(CPPPATH=[Dir("ct_writer/include").srcnode()])
_ct_writer_dir = Dir("ct_writer").srcnode()
_ct_writer_arch_dir = Dir("ct_writer/%s-%s" % (env["platform"], env["arch"])).srcnode()
if os.path.exists(os.path.join(str(_ct_writer_arch_dir), "libcodetracer_trace_writer.a")):
    _ct_writer_dir = _ct_writer_arch_dir
env.Append(LIBPATH=[_ct_writer_dir])
env.Append(LIBS=["codetracer_trace_writer"])
# Runtime deps the Nim/arc static lib pulls in:
if env["platform"] in ["linuxbsd", "android"]:
    env.Append(LIBS=["zstd", "m", "pthread"])
elif env["platform"] == "macos":
    env.Append(LIBS=["zstd"])
    env.Append(LINKFLAGS=["-framework", "Security", "-framework", "CoreFoundation"])

env_gdscript.add_source_files(env.modules_sources, "*.cpp")

if env.editor_build:
    env_gdscript.add_source_files(env.modules_sources, "./editor/*.cpp")

    SConscript("editor/script_templates/SCsub")

    # Those two modules are required for the language server protocol
    if env["module_jsonrpc_enabled"] and env["module_websocket_enabled"]:
        env_gdscript.add_source_files(env.modules_sources, "./language_server/*.cpp")
    else:
        # Using a define in the disabled case, to avoid having an extra define
        # in regular builds where all modules are enabled.
        env_gdscript.Append(CPPDEFINES=["GDSCRIPT_NO_LSP"])
        # Also needed in main env to unexpose --lsp-port option.
        env.Append(CPPDEFINES=["GDSCRIPT_NO_LSP"])


if env["tests"]:
    env_gdscript.Append(CPPDEFINES=["TESTS_ENABLED"])
    env_gdscript.add_source_files(env.modules_sources, "./tests/*.cpp")
