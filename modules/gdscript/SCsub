#!/usr/bin/env python
from misc.utility.scons_hints import *

import os

Import("env")
Import("env_modules")

env_gdscript = env_modules.Clone()

# --- GDH-M5 falsifier arms ---------------------------------------------
# `CT_GDH5_FALSIFY` names a mutation to compile into the recorder's reload
# path, and it is applied to THIS MODULE'S environment only.
#
# It is scoped here rather than added to the global CCFLAGS for a measured
# reason: a change to the engine-wide CCFLAGS invalidates every object in the
# tree, so the first version of the GDH-M5 arm runner triggered a FULL rebuild
# (thirdparty/embree and all) per arm — four of them, about an hour. Scoped to
# `env_gdscript`, an armed build is one translation unit plus a relink, ~20 s.
#
# It is empty in every ordinary build. `scripts/record-and-verify-gdh5.sh` is
# its only user, and it prints the value so an armed binary cannot be mistaken
# for a plain one.
_ct_gdh5_falsify = os.environ.get("CT_GDH5_FALSIFY", "")
if _ct_gdh5_falsify:
    print("CodeTracer GDH-M5 FALSIFIER ARM: -D%s (this is NOT a plain build)"
          % _ct_gdh5_falsify)
    env_gdscript.Append(CPPDEFINES=[_ct_gdh5_falsify])

# --- GDH-M6 falsifier arms ---------------------------------------------
# Same mechanism, same scope, same reason. `CT_GDH6_FALSIFY` may name MORE
# than one mutation, comma-separated, because two of GDH-M6's gates are
# graded against the same recording and an arm aimed at one of them has to
# be shown not to have reddened the other by accident.
_ct_gdh6_falsify = os.environ.get("CT_GDH6_FALSIFY", "")
if _ct_gdh6_falsify:
    for _arm in [a.strip() for a in _ct_gdh6_falsify.split(",") if a.strip()]:
        print("CodeTracer GDH-M6 FALSIFIER ARM: -D%s (this is NOT a plain build)"
              % _arm)
        env_gdscript.Append(CPPDEFINES=[_arm])

# --- GDH-M8 falsifier arms, and the injection-hook OPT-OUT ---------------
# Same mechanism and same scope. Two kinds of define arrive through it and the
# difference is worth stating, because one of them is not a falsifier:
#
#   CT_GDH8_FALSIFY_*         a mutation, exactly like the GDH-M5/M6 arms.
#   CT_GDH8_NO_INJECTION_HOOK compiles the fault-injection hook OUT.
#
# The second exists because `gdh8_a_failure_after_registration_closes_the_
# trace_rather_than_continuing` injects its failure through a hook in SHIPPED
# code, and the milestone accepts that only if the hook's inertness is
# MEASURED. The measurement is "an unarmed build with the hook produces a
# container byte-identical to a build without it", and the second build is what
# this define produces. A comment asserting the hook is off would not be a
# measurement.
_ct_gdh8_falsify = os.environ.get("CT_GDH8_FALSIFY", "")
if _ct_gdh8_falsify:
    for _arm in [a.strip() for a in _ct_gdh8_falsify.split(",") if a.strip()]:
        print("CodeTracer GDH-M8 FALSIFIER ARM: -D%s (this is NOT a plain build)"
              % _arm)
        env_gdscript.Append(CPPDEFINES=[_arm])

# --- GDH-M6 AddressSanitizer, scoped to this module ---------------------
# `gdh6_a_timed_out_deferral_does_not_outlive_its_request` is killed by the
# SANITIZER'S REPORT, never by a crash: the defect it guards is a
# use-after-free with a 30-second fuse, and a fuse that long usually does not
# blow on demand. So the recorder's translation unit is built with
# `-fsanitize=address` and the engine is linked against the runtime.
#
# Scoped to `env_gdscript` for the compile and to `env` for the link, exactly
# as the writer's static library is: an engine-wide `-fsanitize=address`
# invalidates every object in the tree and costs a full rebuild (measured at
# 813 s while bringing GDH-M5's arms up), whereas this is one translation unit
# plus a relink.
#
# `detect_leaks=0` is NOT set here. The gate sets ASAN_OPTIONS itself, so the
# choice is visible in the harness rather than baked into the binary.
#
# `ASAN_ENABLED` IS REQUIRED FROM GODOT 4.7 ONWARDS, and it is not optional
# bookkeeping. 4.7 added a guard to `core/typedefs.h` (:65-67):
#
#     #if (GD_HAS_FEATURE(address_sanitizer) || defined(__SANITIZE_ADDRESS__)) \
#             && !defined(ASAN_ENABLED)
#     #error Address sanitizer was enabled without defining `ASAN_ENABLED`
#
# so at 4.6.2 this block worked with the flag alone and at 4.7.2 it stops the
# build dead — every `modules/gdscript` translation unit fails at the `#error`.
# Upstream pairs the two itself wherever it turns the sanitizer on (see
# `platform/linuxbsd/detect.py`'s `use_asan` branch, which does
# `CPPDEFINES=["ASAN_ENABLED"]` immediately before the `-fsanitize=address`
# CCFLAGS), and this mirrors that pairing at the scope we use. It is defined on
# `env_gdscript` only, matching where the flag is applied: the rest of the tree
# is not sanitized and must not claim to be, since `ASAN_ENABLED` also gates
# real behaviour in the engine (allocator hooks, poisoning helpers).
if os.environ.get("CT_GDH6_ASAN", "") not in ("", "0"):
    print("CodeTracer GDH-M6: -fsanitize=address on modules/gdscript "
          "(this is NOT a plain build)")
    env_gdscript.Append(CPPDEFINES=["ASAN_ENABLED"])
    env_gdscript.Append(CCFLAGS=["-fsanitize=address", "-fno-omit-frame-pointer"])
    env.Append(LINKFLAGS=["-fsanitize=address"])

# --- CodeTracer G2: link the CTFS writer static lib ---------------------
# The C-ABI header (compile-time) and libcodetracer_trace_writer.a
# (link-time) come from codetracer-trace-format-nim, vendored under
# modules/gdscript/ct_writer/ (header in ct_writer/include/). The glue TU
# gdscript_ct_trace.cpp is picked up by the "*.cpp" glob below.
# The static lib is a *native* object archive, so it is vendored per host
# platform+arch: `ct_writer/` holds the macOS arm64 build (the platform the
# recorder was first brought up on) and `ct_writer/<platform>-<arch>/` (scons'
# own platform/arch spelling, e.g. `linuxbsd-x86_64`) holds any other build.
# Note the two archives are not interchangeable in a subtler way than being
# different ISAs: the macOS one carries a `__.SYMDEF` index, which GNU ld
# rejects outright ("archive has no index"), so a Linux link that silently
# picked it up fails at the very last step of a full engine build.
# The Linux x86_64 archive was produced from
# codetracer-trace-format-nim with the repo's own `buildStaticLib` command
# (`nim c --app:staticlib --mm:arc --noMain -d:release
#  --nimMainPrefix:codetracerTraceWriter --passC:-fPIC -p:src`), run inside
# that repo's `nix develop` shell so libzstd's headers resolve.
#
# RESOLVED, HX-D-0 (2026-09-14): `ct_writer/libcodetracer_trace_writer.a`,
# the macOS-arm64 fallback archive, was regenerated on a macOS arm64 host
# from codetracer-trace-format-nim using:
#   nix develop --command just build-static-lib
# (which executes: `nim c --app:staticlib --mm:arc --noMain -d:release
#   --nimMainPrefix:codetracerTraceWriter --passC:"-fPIC" -p:src
#   -o:libcodetracer_trace_writer.a src/codetracer_trace_writer_ffi.nim`).
# The regenerated archive exports all required entry points (including
# `trace_writer_current_path_id`, `trace_writer_register_path_version`,
# `trace_writer_set_recording_id`, `trace_writer_enable_line_count_table`,
# `trace_writer_register_path_with_line_count`, `trace_writer_clear_last_error`),
# matching the exported symbol set of the Linux archive.
# Provenance and rebuild procedure:
# If this archive ever becomes stale relative to codetracer-trace-format-nim,
# run on a macOS arm64 host:
#   cd ../codetracer-trace-format-nim && nix develop --command just build-static-lib
#   cp libcodetracer_trace_writer.a ../codetracer-engine-godot/modules/gdscript/ct_writer/
# `scripts/verify-gdh3-fork.sh` actively guards this archive with an
# anti-vacuity floor check and fails if any required entry point is missing.
env_gdscript.Prepend(CPPPATH=[Dir("ct_writer/include").srcnode()])
_ct_writer_dir = Dir("ct_writer").srcnode()
_ct_writer_arch_dir = Dir("ct_writer/%s-%s" % (env["platform"], env["arch"])).srcnode()
if os.path.exists(os.path.join(str(_ct_writer_arch_dir), "libcodetracer_trace_writer.a")):
    _ct_writer_dir = _ct_writer_arch_dir
env.Append(LIBPATH=[_ct_writer_dir])
env.Append(LIBS=["codetracer_trace_writer"])
# Runtime deps the Nim/arc static lib pulls in:
if env["platform"] in ["linuxbsd", "android"]:
    env.Append(LIBS=["zstd", "m", "pthread"])
elif env["platform"] == "macos":
    env.Append(LIBS=["zstd"])
    env.Append(LINKFLAGS=["-framework", "Security", "-framework", "CoreFoundation"])

env_gdscript.add_source_files(env.modules_sources, "*.cpp")

if env.editor_build:
    env_gdscript.add_source_files(env.modules_sources, "./editor/*.cpp")

    SConscript("editor/script_templates/SCsub")

    # Those two modules are required for the language server protocol
    if env["module_jsonrpc_enabled"] and env["module_websocket_enabled"]:
        env_gdscript.add_source_files(env.modules_sources, "./language_server/*.cpp")
    else:
        # Using a define in the disabled case, to avoid having an extra define
        # in regular builds where all modules are enabled.
        env_gdscript.Append(CPPDEFINES=["GDSCRIPT_NO_LSP"])
        # Also needed in main env to unexpose --lsp-port option.
        env.Append(CPPDEFINES=["GDSCRIPT_NO_LSP"])


if env["tests"]:
    # TODO: Handle test creation magic without needing to pass macro.
    env_gdscript.Append(CPPDEFINES=["TESTS_ENABLED"])
    env_gdscript.add_source_files(env.modules_sources, "./tests/*.cpp")
