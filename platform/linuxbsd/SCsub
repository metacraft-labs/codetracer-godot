#!/usr/bin/env python
from misc.utility.scons_hints import *

Import("env")

import os

import platform_linuxbsd_builders

common_linuxbsd = [
    "crash_handler_linuxbsd.cpp",
    "os_linuxbsd.cpp",
    "freedesktop_portal_desktop.cpp",
    "freedesktop_screensaver.cpp",
    "freedesktop_at_spi_monitor.cpp",
]

if env["library_type"] == "executable":
    common_linuxbsd += ["godot_linuxbsd.cpp"]
else:
    common_linuxbsd += ["libgodot_linuxbsd.cpp"]

if env["use_sowrap"]:
    common_linuxbsd.append("xkbcommon-so_wrap.c")

if env["x11"]:
    common_linuxbsd += SConscript("x11/SCsub")

if env["wayland"]:
    common_linuxbsd += SConscript("wayland/SCsub")

if env["speechd"]:
    common_linuxbsd.append("tts_linux.cpp")
    if env["use_sowrap"]:
        common_linuxbsd.append("speechd-so_wrap.c")

if env["fontconfig"]:
    if env["use_sowrap"]:
        common_linuxbsd.append("fontconfig-so_wrap.c")

if env["dbus"]:
    if env["use_sowrap"]:
        common_linuxbsd.append("dbus-so_wrap.c")

# CodeTracer HCR agent. Compiled from the reprobuild checkout in place (see
# `hcr_agent_source` in the SConstruct) rather than vendored here, so the engine
# always links the same agent the coordinator on the other end of the socket was
# built against. The explicit `target=` keeps its object inside `bin/obj`
# instead of next to the source in the other repo.
#
# GDH-M8: `CT_GDH8_AGENT_FALSIFY` names a mutation to compile into the AGENT's
# translation unit — `gdh8_digest_mismatch_is_refused_before_anything_is_
# touched`'s falsifier is "skip the digest check", and the digest check lives in
# repro_hcr_agent.c rather than in the engine. It is scoped to THIS ONE OBJECT
# through a cloned environment, for the reason modules/gdscript/SCsub states at
# length: a define added to the engine-wide CCFLAGS invalidates every object in
# the tree and turns a ~20 s relink into a full rebuild.
#
# The arm is compiled into a copy of the production agent's source, in place, so
# the mutation is a real mutation of the shipped file's behaviour and not of a
# fork of it.
if env["library_type"] == "executable" and env["hcr_agent_source"]:
    env_hcr_agent = env.Clone()
    _ct_gdh8_agent_falsify = os.environ.get("CT_GDH8_AGENT_FALSIFY", "")
    if _ct_gdh8_agent_falsify:
        for _arm in [a.strip() for a in _ct_gdh8_agent_falsify.split(",") if a.strip()]:
            print(
                "CodeTracer GDH-M8 FALSIFIER ARM: -D%s on the HCR agent "
                "(this is NOT a plain build)" % _arm
            )
            env_hcr_agent.Append(CPPDEFINES=[_arm])
    common_linuxbsd += env_hcr_agent.Object(
        target="#bin/obj/hcr/repro_hcr_agent" + env["OBJSUFFIX"],
        source=env["hcr_agent_source"],
    )

if env["library_type"] == "static_library":
    prog = env.add_library("#bin/godot", common_linuxbsd)
elif env["library_type"] == "shared_library":
    prog = env.add_shared_library("#bin/godot", common_linuxbsd)
else:
    prog = env.add_program("#bin/godot", common_linuxbsd)

if env["debug_symbols"] and env["separate_debug_symbols"]:
    env.AddPostAction(prog, env.Run(platform_linuxbsd_builders.make_debug_linuxbsd))
